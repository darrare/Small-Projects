@using System.Globalization
@inject IJSRuntime JS

<div class="scheduler-container d-flex flex-column vh-100">
    <!-- Month / Year Header -->
    <div class="scheduler-header bg-body-tertiary border-bottom p-3 d-flex justify-content-between align-items-center sticky-top">
        <div>
            <h4 class="mb-0">@GetMonthName(CurrentMonth)</h4>
            <small>@CurrentYear</small>
        </div>
        <div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToDate(DateTime.Today)">Today</button>
        </div>
    </div>

    <!-- Weekday Names Header -->
    <div class="weekdays-header d-grid border-bottom sticky-top bg-body" style="grid-template-columns: repeat(7, 1fr);">
        @foreach (var day in CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames)
        {
            <div class="text-center fw-semibold py-1">@day</div>
        }
    </div>

    <!-- Scrollable Weeks -->
    <div @ref="_scrollContainer" class="flex-grow-1 overflow-auto">
        <Virtualize Context="week" ItemsProvider="LoadWeeks" ItemSize="150" TItem="WeekViewModel">
            <ItemContent>
                <div class="week-row d-grid px-2 position-relative" style="grid-template-columns: repeat(7, 1fr);" data-week-start="@week.StartOfWeek.ToString("o")">
                    <!-- Event bars -->
                    @foreach (var ev in week.Events)
                    {
                        <div class="week-event position-absolute"
                             style="
                                left: @(ev.StartIndex * (100.0 / 7))%;
                                width: @((ev.EndIndex - ev.StartIndex + 1) * (100.0 / 7))%;
                                background-color: @ev.Event.Color;
                                top: @(25 + ev.TopOffset * 22)px;">
                            @ev.Event.Title
                        </div>
                    }

                    <!-- Day cells -->
                    @foreach (var day in week.Days)
                    {
                        <div class="@GetDayCss(day)">
                            <!-- Day Header -->
                            <div class="day-cell-header fw-semibold text-center">
                                @(day.Day == 1 ? $"{day.ToString("MMMM")} {day.Day}" : $"{day.Day}")
                            </div>
                        </div>
                    }
                </div>
            </ItemContent>
        </Virtualize>
    </div>
</div>